# Copy to .env and adjust. Used by docker compose itself.

# Image version (a release tag without the "v"). Pin it; do not use "latest".
SENDORA_VERSION=0.3.0

# Local use: address and port on this machine.
SENDORA_BIND=127.0.0.1
SENDORA_PORT=8080
APP_URL=http://localhost:8080

# HTTPS override (docker-compose.https.yml): your public DNS name.
# SENDORA_DOMAIN=files.example.com

# Where the data and the database key live on this machine.
SENDORA_DATA_DIR=./data
SENDORA_DB_KEY_HOST_FILE=./database.key

# Set to true only for the very first start (new, empty database), then back to false.
SENDORA_DB_INITIALIZE=false

TZ=Europe/Amsterdam
